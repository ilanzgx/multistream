{
  "name": "multistream-monorepo",
  "private": true,
  "version": "0.18.11",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "version": "bun run scripts/sync-version.ts",
    "dev:desktop": "cd apps/desktop && bun run dev",
    "dev:desktop:tauri": "cd apps/desktop && bun run tauri:dev",
    "typecheck:desktop": "cd apps/desktop && bun run typecheck",
    "test:desktop": "cd apps/desktop && bun run test",
    "test:desktop:e2e": "cd apps/desktop && bun run test:e2e",
    "dev:website": "cd apps/website && bun run dev",
    "build:desktop": "cd apps/desktop && bun run build",
    "build:desktop:tauri": "cd apps/desktop && bun run tauri:build",
    "build:website": "cd apps/website && bun run build",
    "check:website": "cd apps/website && bun run check",
    "prepare": "husky",
    "lint": "oxlint && eslint .",
    "lint:fix": "prettier --write . && oxlint --fix && eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-oxlint": "^1.68.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxlint": "^1.68.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write",
      "oxlint --fix",
      "eslint --fix"
    ],
    "*.rs": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0,
        "always"
      ]
    }
  }
}
