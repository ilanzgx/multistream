---
// Client-side language detection for /changelog
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Multistream - Changelog</title>
    <link rel="canonical" href={new URL("/en/changelog/", Astro.site)} />
    <script is:inline>
      const lang = navigator.language || navigator.userLanguage;
      if (lang && lang.toLowerCase().startsWith("pt")) {
        window.location.replace("/pt-br/changelog/");
      } else {
        window.location.replace("/en/changelog/");
      }
    </script>
    <meta http-equiv="refresh" content="0; url=/en/changelog/" />
  </head>
  <body style="background-color: #0f1115;"></body>
</html>
