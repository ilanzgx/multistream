---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { fetchLatestReleaseAssets, type GitHubAsset } from "../lib/github";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const releaseAssets: GitHubAsset[] = await fetchLatestReleaseAssets();

const getUrl = (ext: string, incl: string = "") =>
  releaseAssets.find(
    (a) => a.name.toLowerCase().endsWith(ext) && a.name.toLowerCase().includes(incl)
  )?.browser_download_url || "https://github.com/ilanzgx/multistream/releases/latest";
---

<section class="w-full py-16 sm:py-20 border-t border-[rgba(0,0,0,0.06)] dark:border-white/5 bg-[#F7F6F3] dark:bg-[#0c0d10] text-center">
  <div class="max-w-2xl mx-auto px-6 flex flex-col items-center">
    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#EAEAEA] mb-3">
      {t("cta.title")}
    </h2>
    <p class="text-sm sm:text-base text-gray-600 dark:text-[#A0A0A0] mb-8 max-w-lg leading-relaxed">
      {t("cta.subtitle")}
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
      <a
        id="bottom-cta-download"
        href={getUrl(".exe")}
        data-win={getUrl(".exe")}
        data-mac={getUrl(".dmg", "arm64")}
        data-linux={getUrl(".deb")}
        class="w-full sm:w-auto py-3 px-6 bg-[#111111] text-[#FFFFFF] hover:bg-black dark:bg-[#EAEAEA] dark:text-[#111111] dark:hover:bg-white font-semibold rounded-lg transition-transform hover:scale-[0.98] active:scale-95 shadow-sm text-sm sm:text-base flex items-center justify-center gap-2"
      >
        <svg
          class="w-4 h-4 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        {t("cta.download")}
      </a>

      <a
        href="https://github.com/ilanzgx/multistream"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto py-3 px-6 bg-white dark:bg-[#14161a] text-[#111111] dark:text-[#EAEAEA] font-medium rounded-lg transition-transform hover:scale-[0.98] active:scale-95 border border-[rgba(0,0,0,0.08)] dark:border-white/10 hover:border-[rgba(0,0,0,0.15)] dark:hover:border-white/20 shadow-sm text-sm sm:text-base flex items-center justify-center gap-2"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        {t("cta.github")}
      </a>
    </div>
  </div>
</section>

<script>
  (() => {
    const userAgent = navigator.userAgent.toLowerCase();
    const btn = document.getElementById("bottom-cta-download") as HTMLAnchorElement | null;
    if (btn) {
      if (userAgent.includes("mac") || userAgent.includes("darwin")) {
        btn.href = btn.dataset.mac || btn.href;
      } else if (userAgent.includes("linux") || userAgent.includes("x11")) {
        btn.href = btn.dataset.linux || btn.href;
      }
    }
  })();
</script>
