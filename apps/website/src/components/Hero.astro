---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { fetchLatestReleaseAssets, type GitHubAsset } from "../lib/github";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const releaseAssets: GitHubAsset[] = await fetchLatestReleaseAssets();

const getUrl = (ext: string, incl: string = "") =>
  releaseAssets.find(
    (a) => a.name.toLowerCase().endsWith(ext) && a.name.toLowerCase().includes(incl)
  )?.browser_download_url || "https://github.com/ilanzgx/multistream/releases/latest";
---

<script is:inline>
  (() => {
    const params = new URLSearchParams(window.location.search);
    const action = params.get("action");
    const streams = params.get("streams");
    const code = params.get("code");
    const oauthState = params.get("state");
    if (action === "share" && streams) {
      document.documentElement.classList.add("has-deeplink");
    } else if (code && oauthState && action !== "share") {
      document.documentElement.classList.add("has-kick-callback");
    }
  })();
</script>

<style>
  :global(html.has-deeplink) #hero-content,
  :global(html.has-kick-callback) #hero-content {
    display: none !important;
  }
  :global(html.has-deeplink) #deep-link-content,
  :global(html.has-kick-callback) #kick-callback-content {
    display: flex !important;
  }
</style>

<section
  class="w-full pt-12 sm:pt-16 lg:pt-20 pb-12 sm:pb-16 flex flex-col items-center justify-center"
  aria-labelledby="hero-title"
>
  <div
    id="hero-content"
    class="w-full max-w-7xl mx-auto px-6 flex flex-col lg:grid lg:grid-cols-12 lg:gap-10 xl:gap-14 items-center"
  >
    <div class="w-full lg:col-span-5 flex flex-col items-center lg:items-start text-center lg:text-left">
      <h1
        id="hero-title"
        class="text-4xl sm:text-5xl lg:text-4xl xl:text-5xl font-extrabold tracking-tight text-[#111111] dark:text-[#EAEAEA] mb-4 sm:mb-6 leading-tight"
      >
        {t("hero.title")}
      </h1>
      <p class="text-base sm:text-lg text-gray-600 dark:text-[#A0A0A0] mb-8 max-w-xl leading-relaxed">
        {t("hero.subtitle")}
      </p>

      <div
        id="download-buttons"
        class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full max-w-[420px]"
      >
        <a
          id="btn-win"
          href={getUrl(".exe")}
          data-os="windows"
          data-umami-event="download-windows"
          data-umami-event-source="hero"
          class="w-full sm:col-span-2 py-3.5 px-6 bg-[#111111] text-[#FFFFFF] hover:bg-black dark:bg-[#EAEAEA] dark:text-[#111111] dark:hover:bg-white font-semibold rounded-lg transition-transform hover:scale-[0.98] active:scale-95 border border-transparent flex items-center justify-center gap-2 shadow-sm text-sm sm:text-base"
        >
          <img
            src="/windows-icon.svg"
            alt=""
            aria-hidden="true"
            class="w-5 h-5 invert dark:invert-0 opacity-90"
            width="20"
            height="20"
          />
          {t("hero.download_win")}
        </a>
        <a
          id="btn-linux"
          href={getUrl(".deb")}
          data-os="linux"
          data-umami-event="download-linux"
          data-umami-event-source="hero"
          class="w-full sm:col-span-1 py-2.5 px-3 bg-white dark:bg-[#14161a] text-[#111111] dark:text-[#EAEAEA] font-medium rounded-lg transition-transform hover:scale-[0.98] active:scale-95 border border-[rgba(0,0,0,0.08)] dark:border-white/10 flex items-center justify-center gap-2 shadow-sm hover:border-[rgba(0,0,0,0.15)] dark:hover:border-white/20 text-xs sm:text-sm"
        >
          <img
            src="/linux-icon.svg"
            alt=""
            aria-hidden="true"
            class="w-4 h-4 dark:invert opacity-90"
            width="16"
            height="16"
          />
          {t("hero.download_linux")}
        </a>
        <a
          id="btn-mac"
          href={getUrl(".dmg", "arm64")}
          data-os="mac"
          data-umami-event="download-mac"
          data-umami-event-source="hero"
          class="w-full sm:col-span-1 py-2.5 px-3 bg-white dark:bg-[#14161a] text-[#111111] dark:text-[#EAEAEA] font-medium rounded-lg transition-transform hover:scale-[0.98] active:scale-95 border border-[rgba(0,0,0,0.08)] dark:border-white/10 flex items-center justify-center gap-2 shadow-sm hover:border-[rgba(0,0,0,0.15)] dark:hover:border-white/20 text-xs sm:text-sm"
        >
          <img
            src="/macos-icon.svg"
            alt=""
            aria-hidden="true"
            class="w-4 h-4 dark:invert opacity-90"
            width="16"
            height="16"
          />
          {t("hero.download_mac")}
        </a>
      </div>

      <div class="w-full max-w-[420px] flex justify-center">
        <button
          id="btn-all-downloads"
          type="button"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="downloads-modal"
          data-umami-event="open-all-downloads"
          class="mt-4 cursor-pointer text-sm text-gray-600 dark:text-gray-400 hover:text-[#111111] dark:hover:text-white transition-colors"
        >
          {t("hero.all_downloads")}
        </button>
      </div>
    </div>

    <!-- App Preview Frame -->
    <div class="w-full lg:col-span-7 mt-10 lg:mt-0 flex items-center justify-center">
      <div class="w-full overflow-hidden rounded-xl border border-[rgba(0,0,0,0.08)] bg-[#14161a] shadow-2xl transition-all duration-300 dark:border-white/10 sm:rounded-2xl">
        <img
          src="/preview.png"
          alt={t("hero.preview_alt")}
          class="block h-auto w-full object-cover"
          width="1919"
          height="1041"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <!-- Deep Link Gateway -->
  <div
    id="deep-link-content"
    class="hidden max-w-2xl w-full mx-4 sm:mx-0 p-8 rounded-xl bg-[#E1F3FE] border border-[#1F6C9F]/20 dark:bg-[#14161a] dark:border-[rgba(255,255,255,0.05)] flex flex-col items-center mt-4"
  >
    <div
      class="w-16 h-16 rounded-full bg-[#1F6C9F]/10 dark:bg-white/5 flex items-center justify-center mb-4 text-[#1F6C9F] dark:text-gray-300"
      aria-hidden="true"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
    </div>
    <h2 class="text-2xl font-bold text-[#111111] dark:text-[#EAEAEA] mb-2">
      {t("hero.deep_link_title")}
    </h2>
    <p class="text-gray-700 dark:text-gray-300 mb-8">{t("hero.deep_link_subtitle")}</p>
    <a
      id="deep-link-btn"
      href="#"
      class="px-10 py-4 bg-[#1F6C9F] hover:bg-[#154e73] text-white dark:bg-[#EAEAEA] dark:text-[#111111] dark:hover:bg-white font-semibold rounded-lg transition-transform hover:scale-[0.98] active:scale-95 animate-pulse-subtle flex items-center gap-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="20" height="14" x="2" y="3" rx="2" />
        <line x1="8" x2="16" y1="21" y2="21" />
        <line x1="12" x2="12" y1="17" y2="21" />
      </svg>
      {t("hero.deep_link_button")}
    </a>
    <button
      id="deep-link-cancel-btn"
      type="button"
      class="mt-6 text-sm cursor-pointer font-medium text-gray-700 hover:text-[#111111] dark:text-gray-300 dark:hover:text-white transition-colors underline underline-offset-4"
    >
      {t("hero.deep_link_no_app")}
    </button>
  </div>

  <!-- Kick Callback -->
  <div
    id="kick-callback-content"
    class="hidden max-w-2xl w-full mx-4 sm:mx-0 p-8 rounded-xl bg-[#E1F3FE] border border-[#1F6C9F]/20 dark:bg-[#14161a] dark:border-[rgba(255,255,255,0.05)] flex flex-col items-center mt-4"
    role="status"
  >
    <div
      class="w-16 h-16 rounded-full bg-green-500/10 flex items-center justify-center mb-4 text-green-500 dark:text-green-400"
      aria-hidden="true"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
        <path d="m9 11 3 3L22 4" />
      </svg>
    </div>
    <h2 class="text-2xl font-bold text-[#111111] dark:text-[#EAEAEA] mb-2">
      {t("hero.kick_callback_title")}
    </h2>
    <p class="text-gray-700 dark:text-gray-300">{t("hero.kick_callback_subtitle")}</p>
  </div>

  <!-- Downloads Modal (A11y Compliant) -->
  <div
    id="downloads-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-[2px] opacity-0 pointer-events-none invisible transition-all duration-150 ease-out"
  >
    <div
      class="bg-white dark:bg-[#14161a] border border-[rgba(0,0,0,0.08)] dark:border-white/10 rounded-xl shadow-2xl p-8 max-w-md w-full mx-4 transform-gpu scale-[0.98] transition-all duration-150 ease-out"
      id="downloads-modal-card"
    >
      <div class="flex justify-between items-center mb-6">
        <h2 id="modal-title" class="text-xl font-bold text-[#111111] dark:text-white">
          {t("hero.modal_title")}
        </h2>
        <button
          id="close-modal"
          type="button"
          aria-label={t("hero.modal_close")}
          class="text-gray-600 hover:text-[#111111] dark:text-gray-400 dark:hover:text-white transition-colors p-1 rounded-md"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="space-y-6 text-left">
        <div>
          <h3 class="font-semibold text-[#111111] dark:text-gray-200 mb-3 flex items-center gap-2">
            <img
              src="/windows-icon.svg"
              alt=""
              aria-hidden="true"
              class="w-4 h-4 dark:invert opacity-70"
              width="16"
              height="16"
            />{" "}
            Windows
          </h3>
          <div class="flex flex-col gap-2">
            <a
              id="modal-win-exe"
              href={getUrl(".exe")}
              data-umami-event="download-windows-exe"
              data-umami-event-source="modal"
              class="text-sm text-gray-600 dark:text-gray-400 hover:text-[#111111] dark:hover:text-white"
            >
              {t("hero.modal_win_exe")}
            </a>
            <a
              id="modal-win-msi"
              href={getUrl(".msi")}
              data-umami-event="download-windows-msi"
              data-umami-event-source="modal"
              class="text-sm text-gray-600 dark:text-gray-400 hover:text-[#111111] dark:hover:text-white"
            >
              {t("hero.modal_win_msi")}
            </a>
          </div>
        </div>

        <div>
          <h3 class="font-semibold text-[#111111] dark:text-gray-200 mb-3 flex items-center gap-2">
            <img
              src="/macos-icon.svg"
              alt=""
              aria-hidden="true"
              class="w-4 h-4 dark:invert opacity-70"
              width="16"
              height="16"
            />{" "}
            macOS
          </h3>
          <div class="flex flex-col gap-2">
            <a
              id="modal-mac-arm"
              href={getUrl(".dmg", "arm64")}
              data-umami-event="download-mac-arm"
              data-umami-event-source="modal"
              class="text-sm text-gray-600 dark:text-gray-400 hover:text-[#111111] dark:hover:text-white"
            >
              {t("hero.modal_mac_arm")}
            </a>
            <a
              id="modal-mac-x64"
              href={getUrl(".dmg", "x64")}
              data-umami-event="download-mac-x64"
              data-umami-event-source="modal"
              class="text-sm text-gray-600 dark:text-gray-400 hover:text-[#111111] dark:hover:text-white"
            >
              {t("hero.modal_mac_x64")}
            </a>
          </div>
        </div>

        <div>
          <h3 class="font-semibold text-[#111111] dark:text-gray-200 mb-3 flex items-center gap-2">
            <img
              src="/linux-icon.svg"
              alt=""
              aria-hidden="true"
              class="w-4 h-4 dark:invert opacity-70"
              width="16"
              height="16"
            />{" "}
            Linux
          </h3>
          <div class="flex flex-col gap-2">
            <a
              id="modal-linux-deb"
              href={getUrl(".deb")}
              data-umami-event="download-linux-deb"
              data-umami-event-source="modal"
              class="text-sm text-gray-600 dark:text-gray-400 hover:text-[#111111] dark:hover:text-white"
            >
              {t("hero.modal_linux_deb")}
            </a>
            <a
              id="modal-linux-appimage"
              href={getUrl(".appimage")}
              data-umami-event="download-linux-appimage"
              data-umami-event-source="modal"
              class="text-sm text-gray-600 dark:text-gray-400 hover:text-[#111111] dark:hover:text-white"
            >
              {t("hero.modal_linux_appimage")}
            </a>
          </div>
        </div>

        <div>
          <h3 class="font-semibold text-[#111111] dark:text-gray-200 mb-3 flex items-center gap-2">
            <svg
              class="w-4 h-4 text-gray-500 dark:text-gray-400"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 2v4a2 2 0 0 0 2 2h4" />
              <path d="M4 15h2a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3" />
              <path d="M4 12V4a2 2 0 0 1 2-2h8.5L20 7.5V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-4" />
            </svg>{" "}
            {t("hero.modal_extension_title")}
          </h3>
          <div class="flex flex-col gap-2">
            <a
              id="modal-extension-zip"
              href={getUrl(".zip", "extension")}
              data-umami-event="download-extension-zip"
              data-umami-event-source="modal"
              class="text-sm text-gray-600 dark:text-gray-400 hover:text-[#111111] dark:hover:text-white"
            >
              {t("hero.modal_extension_zip")}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    // 0. Smart OS Detection & CTA Reordering
    const userAgent = navigator.userAgent.toLowerCase();
    let detectedOs = "windows";
    if (userAgent.includes("mac") || userAgent.includes("darwin")) {
      detectedOs = "mac";
    } else if (userAgent.includes("linux") || userAgent.includes("x11")) {
      detectedOs = "linux";
    }

    const downloadButtonsContainer = document.getElementById("download-buttons");
    if (downloadButtonsContainer) {
      const buttons = Array.from(
        downloadButtonsContainer.querySelectorAll<HTMLAnchorElement>("a[data-os]")
      );
      const detectedBtn = buttons.find((btn) => btn.getAttribute("data-os") === detectedOs);

      const PRIMARY_CLASSES =
        "w-full sm:col-span-2 py-3.5 px-6 bg-[#111111] text-[#FFFFFF] hover:bg-black dark:bg-[#EAEAEA] dark:text-[#111111] dark:hover:bg-white font-semibold rounded-lg transition-transform hover:scale-[0.98] active:scale-95 border border-transparent flex items-center justify-center gap-2 shadow-sm text-sm sm:text-base";
      const SECONDARY_CLASSES =
        "w-full sm:col-span-1 py-2.5 px-3 bg-white dark:bg-[#14161a] text-[#111111] dark:text-[#EAEAEA] font-medium rounded-lg transition-transform hover:scale-[0.98] active:scale-95 border border-[rgba(0,0,0,0.08)] dark:border-white/10 flex items-center justify-center gap-2 shadow-sm hover:border-[rgba(0,0,0,0.15)] dark:hover:border-white/20 text-xs sm:text-sm";

      if (detectedBtn && detectedBtn !== buttons[0]) {
        // Reset all buttons to secondary outline style
        buttons.forEach((btn) => {
          btn.className = SECONDARY_CLASSES;
          const img = btn.querySelector("img");
          if (img) {
            img.className = "w-4 h-4 dark:invert opacity-90";
          }
        });

        // Highlight detected OS button with primary styling
        detectedBtn.className = PRIMARY_CLASSES;
        const detectedImg = detectedBtn.querySelector("img");
        if (detectedImg) {
          if (detectedOs === "windows") {
            detectedImg.className = "w-5 h-5 invert dark:invert-0 opacity-90";
          } else {
            detectedImg.className = "w-5 h-5 invert-0 dark:invert opacity-90";
          }
        }

        // Move detected button to the first position
        downloadButtonsContainer.prepend(detectedBtn);
      }
    }

    // 1. Deep link logic com sanitização estrita
    const params = new URLSearchParams(window.location.search);
    const action = params.get("action");
    const streams = params.get("streams");

    if (action === "share" && streams) {
      // Validação estrita: apenas caracteres alfanuméricos, barras, vírgulas, dois-pontos, hífens, arroba e pontos
      const sanitizedStreams = streams.replace(/[^a-zA-Z0-9,/_:@.-]/g, "");

      if (sanitizedStreams.length > 0) {
        const hero = document.getElementById("hero-content");
        const deeplink = document.getElementById("deep-link-content");
        const btn = document.getElementById("deep-link-btn");
        const cancelBtn = document.getElementById("deep-link-cancel-btn");

        if (hero && deeplink && btn) {
          document.documentElement.classList.add("has-deeplink");
          hero.style.display = "none";
          hero.classList.add("hidden");
          deeplink.classList.remove("hidden");
          const deepLinkUrl = `multistream://share?streams=${encodeURIComponent(sanitizedStreams)}`;
          btn.setAttribute("href", deepLinkUrl);

          setTimeout(() => {
            window.location.href = deepLinkUrl;
          }, 500);

          const resetView = () => {
            document.documentElement.classList.remove("has-deeplink");
            deeplink.classList.add("hidden");
            hero.style.display = "";
            hero.classList.remove("hidden");
            window.history.replaceState({}, document.title, window.location.pathname);
          };

          cancelBtn?.addEventListener("click", resetView);
          document.getElementById("header-logo")?.addEventListener("click", (e) => {
            e.preventDefault();
            resetView();
          });
        }
      }
    }

    // Kick OAuth callback
    const code = params.get("code");
    const oauthState = params.get("state");
    if (code && oauthState && action !== "share") {
      const hero = document.getElementById("hero-content");
      const kickCallback = document.getElementById("kick-callback-content");

      if (hero && kickCallback) {
        document.documentElement.classList.add("has-kick-callback");
        hero.style.display = "none";
        hero.classList.add("hidden");
        kickCallback.classList.remove("hidden");
        window.history.replaceState({}, document.title, window.location.pathname);
      }

      window.location.href = `multistream://kick-callback?code=${encodeURIComponent(code)}&state=${encodeURIComponent(oauthState)}`;
    }

    // 2. Modal Logic com Focus Management e A11y
    const modal = document.getElementById("downloads-modal");
    const modalCard = document.getElementById("downloads-modal-card");
    const btnAll = document.getElementById("btn-all-downloads");
    const btnClose = document.getElementById("close-modal");

    let previousActiveElement: HTMLElement | null = null;

    const openModal = () => {
      if (!modal || !modalCard) return;
      previousActiveElement = document.activeElement as HTMLElement;
      btnAll?.setAttribute("aria-expanded", "true");

      modal.classList.remove("opacity-0", "pointer-events-none", "invisible");
      modal.classList.add("opacity-100", "pointer-events-auto", "visible");
      modalCard.classList.remove("scale-[0.98]");
      modalCard.classList.add("scale-100");
      requestAnimationFrame(() => {
        btnClose?.focus();
      });

      document.addEventListener("keydown", handleKeyDown);
    };

    const closeModal = () => {
      if (!modal || !modalCard) return;
      btnAll?.setAttribute("aria-expanded", "false");

      modal.classList.remove("opacity-100", "pointer-events-auto", "visible");
      modal.classList.add("opacity-0", "pointer-events-none", "invisible");
      modalCard.classList.remove("scale-100");
      modalCard.classList.add("scale-[0.98]");

      previousActiveElement?.focus();

      document.removeEventListener("keydown", handleKeyDown);
    };

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        closeModal();
        return;
      }

      // Trap Focus inside modal
      if (e.key === "Tab" && modal) {
        const focusableElements = modal.querySelectorAll<HTMLElement>(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        );
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (e.shiftKey && document.activeElement === firstElement) {
          e.preventDefault();
          lastElement?.focus();
        } else if (!e.shiftKey && document.activeElement === lastElement) {
          e.preventDefault();
          firstElement?.focus();
        }
      }
    };

    btnAll?.addEventListener("click", openModal);
    btnClose?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
  })();
</script>
