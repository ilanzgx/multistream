---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { fetchRecentReleases, type GitHubRelease } from "../lib/github";

interface Props {
  limit?: number;
}

const { limit = 15 } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const releases: GitHubRelease[] = await fetchRecentReleases(limit);
const hasError = releases.length === 0;

// Escape HTML básico para caracteres sensíveis
const escapeHtml = (unsafe: string): string => {
  return unsafe
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
};

// Validador de URL segura para prevenir javascript: e data: URLs (XSS prevention)
const isSafeUrl = (url: string): boolean => {
  return /^https?:\/\//i.test(url.trim());
};

const formatDate = (dateStr: string, locale: string): string => {
  try {
    const date = new Date(dateStr);
    return new Intl.DateTimeFormat(locale === "pt-br" ? "pt-BR" : "en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(date);
  } catch {
    return dateStr;
  }
};

const formatInlineMarkdown = (text: string): string => {
  let formatted = escapeHtml(text);

  // Bold **text**
  formatted = formatted.replace(
    /\*\*([^*]+)\*\*/g,
    '<strong class="font-semibold text-[#111111] dark:text-[#EAEAEA]">$1</strong>'
  );

  // Inline code `code` (no font-mono)
  formatted = formatted.replace(
    /`([^`]+)`/g,
    '<code class="bg-[rgba(0,0,0,0.05)] dark:bg-white/5 px-1.5 py-0.5 rounded text-xs text-[#111111] dark:text-gray-300">$1</code>'
  );

  // Commit links ([hash](url)) (no font-mono)
  formatted = formatted.replace(/\(\[([^\]]+)\]\(([^)]+)\)\)/g, (_match, label, url) => {
    if (!isSafeUrl(url)) return label;
    return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-1.5 py-0.5 ml-1 text-xs font-medium rounded bg-[rgba(0,0,0,0.04)] text-gray-600 hover:text-black hover:bg-[rgba(0,0,0,0.08)] dark:bg-white/5 dark:text-gray-400 dark:hover:text-white dark:hover:bg-white/10 transition-colors border border-[rgba(0,0,0,0.05)] dark:border-white/10 shadow-2xs"><svg class="w-3 h-3 mr-1 opacity-70" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.93 8.5a4.002 4.002 0 0 1-7.86 0H.75a.75.75 0 0 1 0-1.5h3.32a4.002 4.002 0 0 1 7.86 0h3.32a.75.75 0 0 1 0 1.5h-3.32Zm-1.43-.5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"></path></svg>${label}</a>`;
  });

  // Generic links [label](url)
  formatted = formatted.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label, url) => {
    if (!isSafeUrl(url)) return label;
    return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">${label}</a>`;
  });

  return formatted;
};

interface CommitCategory {
  name: string;
  items: string[];
}

interface ParsedRelease {
  version: string;
  title: string;
  dateFormatted: string;
  url: string;
  isLatest: boolean;
  highlightHtml: string[];
  categories: CommitCategory[];
}

const parseRelease = (release: GitHubRelease, index: number): ParsedRelease => {
  const titleParts = release.name ? release.name.split(" - ") : [release.tag_name, ""];
  const version = titleParts[0] || release.tag_name;
  const title = titleParts.slice(1).join(" - ");
  const dateFormatted = formatDate(release.published_at, lang);
  const url =
    release.html_url || `https://github.com/ilanzgx/multistream/releases/tag/${release.tag_name}`;
  const isLatest = index === 0;

  const rawBody = release.body || "";
  // Strip out ## Downloads section if present
  const cleanBody = rawBody.split(/##\s+Downloads/i)[0].trim();
  const rawLines = cleanBody.split("\n");

  const highlightHtml: string[] = [];
  const categories: CommitCategory[] = [];
  let currentCategory: CommitCategory | null = null;

  for (const line of rawLines) {
    const trimmed = line.trim();

    if (trimmed.startsWith("### ")) {
      const catName = trimmed.replace(/^###\s+/, "").trim();
      currentCategory = { name: catName, items: [] };
      categories.push(currentCategory);
    } else if (currentCategory) {
      if (trimmed.startsWith("- ") || trimmed.startsWith("* ")) {
        currentCategory.items.push(trimmed.substring(2).trim());
      }
    } else {
      if (trimmed.startsWith("## ")) {
        const h2Text = trimmed.replace(/^##\s+/, "").trim();
        highlightHtml.push(
          `<h4 class="text-lg font-bold text-[#111111] dark:text-[#EAEAEA] mt-4 mb-2">${escapeHtml(h2Text)}</h4>`
        );
      } else if (trimmed.startsWith("> ")) {
        const quoteText = trimmed.replace(/^>\s+/, "").trim();
        highlightHtml.push(
          `<blockquote class="my-3 pl-3.5 border-l-2 border-emerald-500/50 bg-emerald-500/5 dark:bg-emerald-500/10 py-2 rounded-r-md text-sm text-gray-700 dark:text-gray-300">${formatInlineMarkdown(quoteText)}</blockquote>`
        );
      } else if (trimmed.startsWith("- ") || trimmed.startsWith("* ")) {
        highlightHtml.push(
          `<li class="flex gap-2.5 my-1.5"><span class="text-gray-400 dark:text-gray-500 select-none mt-0.5">•</span><span class="text-sm leading-relaxed">${formatInlineMarkdown(trimmed.substring(2).trim())}</span></li>`
        );
      } else if (trimmed === "---") {
        highlightHtml.push('<hr class="my-4 border-[rgba(0,0,0,0.06)] dark:border-white/5" />');
      } else if (trimmed.length > 0) {
        highlightHtml.push(
          `<p class="text-sm text-gray-600 dark:text-gray-400 my-2 leading-relaxed">${formatInlineMarkdown(trimmed)}</p>`
        );
      }
    }
  }

  return {
    version,
    title,
    dateFormatted,
    url,
    isLatest,
    highlightHtml,
    categories,
  };
};

const parsedReleases = releases.map((r, i) => parseRelease(r, i));
---

<div class="space-y-16">
  {hasError && (
    <div class="text-center py-12 p-8 rounded-xl border border-[rgba(0,0,0,0.08)] dark:border-white/10 bg-white dark:bg-[#14161a]">
      <p class="text-gray-600 dark:text-gray-400">{t("changelog.error")}</p>
    </div>
  )}

  {!hasError &&
    parsedReleases.map((release) => (
      <article class="relative pl-6 sm:pl-8 border-l border-[rgba(0,0,0,0.08)] dark:border-white/10">
        <!-- Timeline node bullet (clean, static dot) -->
        <div
          class:list={[
            "absolute -left-[7px] top-2 w-3.5 h-3.5 rounded-full border-2 border-white dark:border-[#0f1115]",
            release.isLatest ? "bg-emerald-500" : "bg-gray-300 dark:bg-gray-600",
          ]}
          aria-hidden="true"
        />

        <!-- Release Header -->
        <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-6 border-b border-[rgba(0,0,0,0.06)] dark:border-white/5">
          <div class="flex items-center flex-wrap gap-2.5">
            <h3 class="text-2xl font-bold tracking-tight text-[#111111] dark:text-[#EAEAEA]">
              {release.version}
            </h3>
            {release.isLatest && (
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
                {t("changelog.latest")}
              </span>
            )}
            {release.title && (
              <span class="text-sm font-medium text-gray-600 dark:text-gray-400">
                — {release.title}
              </span>
            )}
          </div>

          <div class="flex items-center gap-4">
            <time class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 font-medium whitespace-nowrap">
              {release.dateFormatted}
            </time>
            <a
              href={release.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors"
            >
              <span>{t("changelog.view_github")}</span>
              <svg
                class="w-3.5 h-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </header>

        <!-- Highlights (editorial release overview) -->
        {release.highlightHtml.length > 0 && (
          <div class="mb-8 p-5 sm:p-6 rounded-xl bg-white dark:bg-[#14161a] border border-[rgba(0,0,0,0.06)] dark:border-white/5 shadow-2xs">
            <div class="space-y-1 text-gray-700 dark:text-gray-300">
              {release.highlightHtml.map((line) => (
                <Fragment set:html={line} />
              ))}
            </div>
          </div>
        )}

        <!-- Categorized Commits (Clean, unslop headers) -->
        {release.categories.length > 0 && (
          <div class="space-y-6">
            {release.categories.map((cat) => (
              <div class="space-y-2.5">
                <div class="flex items-center gap-2 pt-1">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-[#111111] dark:text-[#EAEAEA]">
                    {cat.name}
                  </h4>
                  <span class="text-xs text-gray-400 dark:text-gray-500">({cat.items.length})</span>
                </div>
                <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400 pl-1">
                  {cat.items.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-gray-400 dark:text-gray-600 select-none mt-1 text-xs">
                        •
                      </span>
                      <span class="leading-relaxed" set:html={formatInlineMarkdown(item)} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </article>
    ))}
</div>
