---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqs = [
  { q: t("faq.q_free"), a: t("faq.a_free") },
  { q: t("faq.q_account"), a: t("faq.a_account") },
  { q: t("faq.q_performance"), a: t("faq.a_performance") },
  { q: t("faq.q_security"), a: t("faq.a_security") },
  { q: t("faq.q_macos"), a: t("faq.a_macos") },
];
---

<section class="w-full py-16 sm:py-20 border-t border-[rgba(0,0,0,0.06)] dark:border-white/5 bg-transparent">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-10 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#EAEAEA] mb-3">
        {t("faq.title")}
      </h2>
      <p class="text-sm sm:text-base text-gray-600 dark:text-[#A0A0A0] max-w-xl mx-auto">
        {t("faq.subtitle")}
      </p>
    </div>

    <div class="flex flex-col gap-3.5">
      {faqs.map((faq, index) => (
        <details
          class="group rounded-xl border border-[rgba(0,0,0,0.08)] dark:border-white/10 bg-white dark:bg-[#14161a] shadow-xs transition-colors hover:border-[rgba(0,0,0,0.15)] dark:hover:border-white/20"
          open={index === 0}
        >
          <summary class="flex items-center justify-between gap-4 p-5 text-left cursor-pointer list-none select-none font-semibold text-sm sm:text-base text-[#111111] dark:text-[#EAEAEA]">
            <span>{faq.q}</span>
            <svg
              class="w-4 h-4 shrink-0 stroke-current text-gray-500 dark:text-gray-400 transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="faq-answer px-5 pb-5 pt-3 text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed border-t border-[rgba(0,0,0,0.04)] dark:border-white/5">
            <p set:html={faq.a} />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-answer :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8em;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    background-color: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  :global(.dark) .faq-answer :global(code) {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
    color: #eaeaea;
  }
</style>
