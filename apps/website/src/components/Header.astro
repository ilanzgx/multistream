---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { fetchRepoStars, fetchLatestReleaseVersion } from "../lib/github";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stars = await fetchRepoStars();
const latestVersion = await fetchLatestReleaseVersion();

const pathname = Astro.url.pathname;
const isChangelog = pathname.includes("/changelog");

const otherLang = lang === "en" ? "pt-br" : "en";
const otherLangLabel = lang === "en" ? "PT-BR" : "EN";
const otherLangHref = isChangelog ? `/${otherLang}/changelog/` : `/${otherLang}/`;
---

<header class="w-full border-b border-[rgba(0,0,0,0.06)] dark:border-white/5 bg-white/80 dark:bg-[#0f1115]/80 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a
      href={`/${lang}/`}
      id="header-logo"
      class="flex items-center gap-3 hover:opacity-80 transition-opacity"
    >
      <img
        src="/icon.png"
        alt="Multistream Logo"
        class="w-8 h-8 rounded-lg shadow-sm"
        width="32"
        height="32"
      />
      <span class="font-semibold text-lg tracking-tight text-[#111111] dark:text-[#EAEAEA]">
        Multistream
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-6">
      <a
        href={`/${lang}/changelog/`}
        class="flex items-center gap-2 text-sm font-semibold text-gray-800 dark:text-gray-200 hover:opacity-70 transition-opacity group"
      >
        <span>{t("nav.changelog")}</span>
        <span class="inline-flex items-center justify-center px-2 py-0.5 ml-1 text-xs tracking-wider bg-white text-[#111111] border border-[rgba(0,0,0,0.15)] dark:bg-white/10 dark:text-white dark:border-white/20 rounded-full transition-colors shadow-sm">
          {latestVersion}
        </span>
      </a>

      <a
        href="https://ko-fi.com/ilanfonseca"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-gray-800 dark:text-gray-200 hover:opacity-70 transition-opacity flex items-center gap-1.5"
      >
        <svg
          class="w-4 h-4 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
          <line x1="6" y1="2" x2="6" y2="4"></line>
          <line x1="10" y1="2" x2="10" y2="4"></line>
          <line x1="14" y1="2" x2="14" y2="4"></line>
        </svg>
        <span>{t("nav.donate")}</span>
      </a>

      <a
        href="https://github.com/ilanzgx/multistream"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-sm font-semibold text-gray-800 dark:text-gray-200 hover:opacity-70 transition-opacity group"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>{t("nav.github")}</span>
        {stars > 0 && (
          <span class="inline-flex items-center justify-center px-2 py-0.5 ml-1 gap-1 text-xs tracking-widest bg-white text-[#111111] border border-[rgba(0,0,0,0.15)] dark:bg-white/10 dark:text-white dark:border-white/20 rounded-full transition-colors shadow-sm">
            <img
              src="/star-icon.svg"
              alt=""
              aria-hidden="true"
              class="w-3 h-3 dark:invert"
              width="12"
              height="12"
            />{" "}
            {stars}
          </span>
        )}
      </a>

      <div class="flex items-center gap-2 border-l border-[rgba(0,0,0,0.1)] dark:border-white/10 pl-5 ml-1">
        <a
          href={otherLangHref}
          class="text-xs font-bold px-3 h-8 flex items-center justify-center rounded-md border border-[rgba(0,0,0,0.15)] dark:border-white/20 text-[#111111] dark:text-[#EAEAEA] hover:bg-[rgba(0,0,0,0.05)] dark:hover:bg-white/10 transition-colors shadow-sm tracking-wider whitespace-nowrap"
          title="Change Language"
        >
          {otherLangLabel}
        </a>
        <button
          class="theme-toggle w-8 h-8 flex items-center justify-center rounded-md border border-[rgba(0,0,0,0.15)] dark:border-white/20 text-[#111111] dark:text-[#EAEAEA] hover:bg-[rgba(0,0,0,0.05)] dark:hover:bg-white/10 transition-colors shadow-sm"
          aria-label={t("nav.toggle_theme")}
          title={t("nav.toggle_theme")}
        >
          <!-- Sun icon (shows in dark mode) -->
          <svg
            class="w-4 h-4 hidden dark:block stroke-current fill-none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <!-- Moon icon (shows in light mode) -->
          <svg
            class="w-4 h-4 block dark:hidden stroke-current fill-none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Header Actions -->
    <div class="flex md:hidden items-center gap-2">
      <button
        class="theme-toggle w-8 h-8 flex items-center justify-center rounded-md border border-[rgba(0,0,0,0.15)] dark:border-white/20 text-[#111111] dark:text-[#EAEAEA] hover:bg-[rgba(0,0,0,0.05)] dark:hover:bg-white/10 transition-colors shadow-sm"
        aria-label={t("nav.toggle_theme")}
        title={t("nav.toggle_theme")}
      >
        <!-- Sun icon (shows in dark mode) -->
        <svg
          class="w-4 h-4 hidden dark:block stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon icon (shows in light mode) -->
        <svg
          class="w-4 h-4 block dark:hidden stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="w-8 h-8 flex items-center justify-center rounded-md border border-[rgba(0,0,0,0.15)] dark:border-white/20 text-[#111111] dark:text-[#EAEAEA] hover:bg-[rgba(0,0,0,0.05)] dark:hover:bg-white/10 transition-colors shadow-sm"
        aria-label={t("nav.open_menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="hamburger-icon-open"
          class="w-4 h-4 fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg
          id="hamburger-icon-close"
          class="w-4 h-4 hidden fill-none stroke-current"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[rgba(0,0,0,0.06)] dark:border-white/5 bg-white/95 dark:bg-[#0f1115]/95 backdrop-blur-xl px-6 py-4 shadow-lg"
  >
    <nav class="flex flex-col gap-1">
      <a
        href={`/${lang}/changelog/`}
        class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-semibold text-gray-800 dark:text-gray-200 hover:bg-[rgba(0,0,0,0.04)] dark:hover:bg-white/5 transition-colors"
      >
        <span>{t("nav.changelog")}</span>
        <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs tracking-wider bg-white text-[#111111] border border-[rgba(0,0,0,0.15)] dark:bg-white/10 dark:text-white dark:border-white/20 rounded-full transition-colors shadow-sm">
          {latestVersion}
        </span>
      </a>

      <a
        href="https://ko-fi.com/ilanfonseca"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-semibold text-gray-800 dark:text-gray-200 hover:bg-[rgba(0,0,0,0.04)] dark:hover:bg-white/5 transition-colors"
      >
        <svg
          class="w-4 h-4 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
          <line x1="6" y1="2" x2="6" y2="4"></line>
          <line x1="10" y1="2" x2="10" y2="4"></line>
          <line x1="14" y1="2" x2="14" y2="4"></line>
        </svg>
        <span>{t("nav.donate")}</span>
      </a>

      <a
        href="https://github.com/ilanzgx/multistream"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-semibold text-gray-800 dark:text-gray-200 hover:bg-[rgba(0,0,0,0.04)] dark:hover:bg-white/5 transition-colors"
      >
        <div class="flex items-center gap-2.5">
          <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span>{t("nav.github")}</span>
        </div>
        {stars > 0 && (
          <span class="inline-flex items-center justify-center px-2 py-0.5 gap-1 text-xs tracking-widest bg-white text-[#111111] border border-[rgba(0,0,0,0.15)] dark:bg-white/10 dark:text-white dark:border-white/20 rounded-full transition-colors shadow-sm">
            <img
              src="/star-icon.svg"
              alt=""
              aria-hidden="true"
              class="w-3 h-3 dark:invert"
              width="12"
              height="12"
            />{" "}
            {stars}
          </span>
        )}
      </a>

      <div class="border-t border-[rgba(0,0,0,0.06)] dark:border-white/5 my-2 pt-2 flex items-center justify-between px-3">
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400">
          {t("nav.language")}
        </span>
        <a
          href={otherLangHref}
          class="text-xs font-bold px-3 py-1 rounded-md border border-[rgba(0,0,0,0.15)] dark:border-white/20 text-[#111111] dark:text-[#EAEAEA] hover:bg-[rgba(0,0,0,0.05)] dark:hover:bg-white/10 transition-colors shadow-sm tracking-wider"
        >
          {otherLangLabel}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");

    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  };

  document.querySelectorAll(".theme-toggle").forEach((btn) => {
    btn.addEventListener("click", handleToggleClick);
  });

  const menuToggle = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("hamburger-icon-open");
  const iconClose = document.getElementById("hamburger-icon-close");

  if (menuToggle && mobileMenu && iconOpen && iconClose) {
    const closeMenu = () => {
      menuToggle.setAttribute("aria-expanded", "false");
      mobileMenu.classList.add("hidden");
      iconOpen.classList.remove("hidden");
      iconClose.classList.add("hidden");
    };

    menuToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!isExpanded));
      mobileMenu.classList.toggle("hidden");
      iconOpen.classList.toggle("hidden");
      iconClose.classList.toggle("hidden");
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (
        !mobileMenu.classList.contains("hidden") &&
        !menuToggle.contains(target) &&
        !mobileMenu.contains(target)
      ) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
        closeMenu();
        menuToggle.focus();
      }
    });
  }
</script>
